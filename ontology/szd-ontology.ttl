    owl:deprecated true ;
    rdfs:label "publisher (GAMS v0.x)"@en ;
    rdfs:comment "Publisher as a literal. v2.0.0 links the organisation with the object property szdo:hasPublisher."@en ;
    rdfs:isDefinedBy <https://gams.uni-graz.at/o:szd.ontology/0.x> .

szdo:provenanceCharacteristic
    a owl:ObjectProperty ;
    rdfs:seeAlso szdo:hasProvenanceFeature ;
    owl:deprecated true ;
    rdfs:label "provenanceCharacteristic (GAMS v0.x)"@en ;
    rdfs:comment "Links a book to its aggregated szdo:ProvenanceCharacteristic node."@en ;
