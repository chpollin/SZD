    rdfs:label "gnd (GAMS v0.x)"@en ;
    rdfs:isDefinedBy <https://gams.uni-graz.at/o:szd.ontology/0.x> .

szdo:wikidata
    a owl:DatatypeProperty ;
    owl:equivalentProperty szdo:wikidataIdentifier ;
    owl:deprecated true ;
    rdfs:label "wikidata (GAMS v0.x)"@en ;
    rdfs:isDefinedBy <https://gams.uni-graz.at/o:szd.ontology/0.x> .

# -----------------------------------------------------------------------------
# 10.3 Properties whose meaning or datatype differs
# -----------------------------------------------------------------------------

szdo:relationToPerson
    a owl:ObjectProperty ;
    rdfs:subPropertyOf rico:hasOrHadSubject ;
    rdfs:seeAlso szdo:affectedPerson ;
    owl:deprecated true ;
    rdfs:label "relationToPerson (GAMS v0.x)"@en ;
    rdfs:comment "Person named as a subject keyword of an object. Broader than szdo:affectedPerson, which GAMS sets for keywords of the type person_affected."@en ;
    rdfs:isDefinedBy <https://gams.uni-graz.at/o:szd.ontology/0.x> .

szdo:secretarialHand
    a owl:DatatypeProperty ;
    rdfs:seeAlso szdo:scribalHand ;
    owl:deprecated true ;
    rdfs:label "secretarialHand (GAMS v0.x)"@en ;
    rdfs:comment "Scribal hand as a literal. v2.0.0 links the person with the object property szdo:scribalHand."@en ;
    rdfs:isDefinedBy <https://gams.uni-graz.at/o:szd.ontology/0.x> .

szdo:pubPlace
    a owl:DatatypeProperty ;
    rdfs:seeAlso szdo:hasPublicationPlace ;
    owl:deprecated true ;
    rdfs:label "pubPlace (GAMS v0.x)"@en ;
    rdfs:comment "Place of publication as a literal. v2.0.0 links the place with the object property szdo:hasPublicationPlace."@en ;
    rdfs:isDefinedBy <https://gams.uni-graz.at/o:szd.ontology/0.x> .

szdo:publisher
    a owl:DatatypeProperty ;
