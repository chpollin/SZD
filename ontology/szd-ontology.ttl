szdo:objecttyp
    a owl:DatatypeProperty ;
    owl:equivalentProperty szdo:objectType ;
    owl:deprecated true ;
    rdfs:label "objecttyp (GAMS v0.x)"@en ;
    rdfs:comment "GAMS spelling of szdo:objectType."@en ;
    rdfs:isDefinedBy <https://gams.uni-graz.at/o:szd.ontology/0.x> .

szdo:content
