    rdfs:comment "Generic relation used in the life calendar. v2.0.0 uses specific properties (szdo:concernsPerson, szdo:hasPlace, etc.)."@en ;
    rdfs:isDefinedBy <https://gams.uni-graz.at/o:szd.ontology/0.x> .

szdo:glossar
