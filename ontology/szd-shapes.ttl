@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix szdo:    <https://gams.uni-graz.at/o:szd.ontology#> .
@prefix rico:    <https://www.ica.org/standards/RiC/ontology#> .
@prefix lrm:     <http://iflastandards.info/ns/lrm/lrmer/> .
@prefix crm:     <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# =============================================================================
# SHACL Shapes for the Stefan Zweig Digital Estate Ontology (SZDO)
# Validates structural constraints, naming conventions, and completeness.
# =============================================================================

# -----------------------------------------------------------------------------
# Shape 1: Every OWL Class must have bilingual labels and a comment
# -----------------------------------------------------------------------------

szdo:ClassShape
    a sh:NodeShape ;
    sh:targetClass owl:Class ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Every class must have at least one rdfs:label."@en ;
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        sh:minCount 1 ;
        sh:message "Every class must have at least one rdfs:comment."@en ;
    ] .

# Check that labels exist in both languages (via SPARQL constraint)
szdo:ClassBilingualLabelShape
    a sh:NodeShape ;
    sh:targetClass owl:Class ;
    sh:sparql [
        sh:message "Class {$this} is missing a German (de) rdfs:label." ;
        sh:select """
            SELECT $this WHERE {
                $this a owl:Class .
                FILTER NOT EXISTS { $this rdfs:label ?labelDe . FILTER(lang(?labelDe) = 'de') }
                FILTER NOT EXISTS { $this owl:deprecated true }
                FILTER(isIRI($this))
                FILTER(STRSTARTS(STR($this), 'https://gams.uni-graz.at/o:szd.ontology#'))
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "Class {$this} is missing an English (en) rdfs:label." ;
        sh:select """
            SELECT $this WHERE {
                $this a owl:Class .
                FILTER NOT EXISTS { $this rdfs:label ?labelEn . FILTER(lang(?labelEn) = 'en') }
                FILTER NOT EXISTS { $this owl:deprecated true }
                FILTER(isIRI($this))
                FILTER(STRSTARTS(STR($this), 'https://gams.uni-graz.at/o:szd.ontology#'))
            }
        """ ;
    ] .

# -----------------------------------------------------------------------------
# Shape 2: Every OWL ObjectProperty must have a label
# -----------------------------------------------------------------------------

szdo:ObjectPropertyShape
    a sh:NodeShape ;
    sh:targetClass owl:ObjectProperty ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Every object property must have at least one rdfs:label."@en ;
    ] .

# -----------------------------------------------------------------------------
# Shape 3: Every OWL DatatypeProperty must have a label
# -----------------------------------------------------------------------------

szdo:DatatypePropertyShape
    a sh:NodeShape ;
    sh:targetClass owl:DatatypeProperty ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Every datatype property must have at least one rdfs:label."@en ;
    ] .

# -----------------------------------------------------------------------------
# Shape 4: ObjectProperties should have domain and range
# -----------------------------------------------------------------------------

szdo:ObjectPropertyDomainRangeShape
    a sh:NodeShape ;
    sh:targetClass owl:ObjectProperty ;
    sh:sparql [
        sh:message "Object property {$this} has no rdfs:domain declared." ;
        sh:prefixes [
            sh:declare [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ;
            sh:declare [ sh:prefix "owl" ; sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ] ;
            sh:declare [ sh:prefix "szdo" ; sh:namespace "https://gams.uni-graz.at/o:szd.ontology#"^^xsd:anyURI ] ;
        ] ;
        sh:select """
            SELECT $this WHERE {
                $this a owl:ObjectProperty .
                FILTER NOT EXISTS { $this rdfs:domain ?d }
                FILTER NOT EXISTS { $this owl:deprecated true }
                FILTER(isIRI($this))
                FILTER(STRSTARTS(STR($this), 'https://gams.uni-graz.at/o:szd.ontology#'))
            }
        """ ;
    ] .

# -----------------------------------------------------------------------------
# Shape 5: An estate must contain collections
# (for instance data validation)
# -----------------------------------------------------------------------------

szdo:EstateInstanceShape
    a sh:NodeShape ;
    sh:targetClass szdo:Estate ;
    sh:property [
        sh:path szdo:contains ;
        sh:minCount 1 ;
        sh:class szdo:Collection ;
        sh:message "An Estate instance must contain at least one Collection."@en ;
    ] .

# -----------------------------------------------------------------------------
# Shape 6: A record must belong to a collection
# (for instance data validation)
# -----------------------------------------------------------------------------

szdo:RecordInstanceShape
    a sh:NodeShape ;
    sh:targetClass szdo:Record ;
    sh:property [
        sh:path szdo:isPartOf ;
        sh:minCount 1 ;
        sh:class szdo:Collection ;
        sh:message "Every Record must be part of a Collection."@en ;
    ] ;
    # A warning, not a violation: books in private ownership (SZDBIB, holder
    # SZDSTA.12) carry inventory numbers but no shelfmark.
    sh:property [
        sh:path szdo:signature ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
        sh:message "A Record should have a signature (shelfmark)."@en ;
    ] .

# -----------------------------------------------------------------------------
# Shape 7: Person must have a name
# (for instance data validation)
# -----------------------------------------------------------------------------

szdo:PersonInstanceShape
    a sh:NodeShape ;
    sh:targetClass szdo:Person ;
    sh:property [
        sh:path szdo:surname ;
        sh:minCount 1 ;
        sh:message "Every Person must have a surname."@en ;
    ] .

# -----------------------------------------------------------------------------
# Shape 8: A bundle of correspondence must have sender and receiver
# (for instance data validation)
# -----------------------------------------------------------------------------

szdo:BundleOfCorrespondenceInstanceShape
    a sh:NodeShape ;
    sh:targetClass szdo:BundleOfCorrespondence ;
    sh:property [
        sh:path szdo:sender ;
        sh:minCount 1 ;
        sh:class szdo:Person ;
        sh:message "Every BundleOfCorrespondence must have a sender."@en ;
    ] ;
    sh:property [
        sh:path szdo:receiver ;
        sh:minCount 1 ;
        sh:class szdo:Person ;
        sh:message "Every BundleOfCorrespondence must have a receiver."@en ;
    ] .

# -----------------------------------------------------------------------------
# Shape 9: A work index entry must have a title
# (for instance data validation)
# -----------------------------------------------------------------------------

szdo:WorkIndexEntryInstanceShape
    a sh:NodeShape ;
    sh:targetClass szdo:WorkIndexEntry ;
    sh:property [
        sh:path szdo:title ;
        sh:minCount 1 ;
        sh:message "Every WorkIndexEntry must have a title."@en ;
    ] .

# -----------------------------------------------------------------------------
# Shape 10: A biographical event must have a date
# (for instance data validation)
# -----------------------------------------------------------------------------

szdo:BiographicalEventInstanceShape
    a sh:NodeShape ;
    sh:targetClass szdo:BiographicalEvent ;
    sh:property [
        sh:path szdo:when ;
        sh:minCount 1 ;
        sh:message "Every BiographicalEvent must have a date (szdo:when)."@en ;
    ] .

# -----------------------------------------------------------------------------
# Shape 11: Naming convention, szdo: classes are ASCII UpperCamelCase
# -----------------------------------------------------------------------------

szdo:NamingConventionClassShape
    a sh:NodeShape ;
    sh:targetClass owl:Class ;
    sh:sparql [
        sh:message "Class local name '{$this}' is not ASCII UpperCamelCase." ;
        sh:select """
            SELECT $this WHERE {
                $this a owl:Class .
                FILTER(isIRI($this))
                FILTER(STRSTARTS(STR($this), 'https://gams.uni-graz.at/o:szd.ontology#'))
                BIND(REPLACE(STR($this), '^.*#', '') AS ?local)
                FILTER(!REGEX(?local, '^[A-Z][A-Za-z0-9]*$'))
            }
        """ ;
    ] .

# -----------------------------------------------------------------------------
# Shape 12: Naming convention, szdo: properties are ASCII lowerCamelCase
# -----------------------------------------------------------------------------

szdo:NamingConventionPropertyShape
    a sh:NodeShape ;
    sh:targetSubjectsOf rdf:type ;
    sh:sparql [
        sh:message "Property local name '{$this}' is not ASCII lowerCamelCase." ;
        sh:select """
            SELECT $this WHERE {
                { $this a owl:ObjectProperty } UNION { $this a owl:DatatypeProperty }
                FILTER(isIRI($this))
                FILTER(STRSTARTS(STR($this), 'https://gams.uni-graz.at/o:szd.ontology#'))
                BIND(REPLACE(STR($this), '^.*#', '') AS ?local)
                FILTER(!REGEX(?local, '^[a-z][A-Za-z0-9]*$'))
            }
        """ ;
    ] .

# -----------------------------------------------------------------------------
# Shape 13: No orphan classes (classes without subClassOf or equivalentClass)
# -----------------------------------------------------------------------------

szdo:OrphanClassShape
    a sh:NodeShape ;
    sh:targetClass owl:Class ;
    sh:sparql [
        sh:message "Class {$this} has no rdfs:subClassOf or owl:equivalentClass — it is orphaned in the hierarchy." ;
        sh:select """
            SELECT $this WHERE {
                $this a owl:Class .
                FILTER(isIRI($this))
                FILTER(STRSTARTS(STR($this), 'https://gams.uni-graz.at/o:szd.ontology#'))
                FILTER NOT EXISTS { $this rdfs:subClassOf ?parent }
                FILTER NOT EXISTS { $this owl:equivalentClass ?eq }
                FILTER NOT EXISTS { $this owl:deprecated true }
            }
        """ ;
    ] .

# -----------------------------------------------------------------------------
# Shape 14: dateEvidence must reference a SKOS concept
# -----------------------------------------------------------------------------

szdo:DateEvidenceShape
    a sh:NodeShape ;
    sh:targetObjectsOf szdo:dateEvidence ;
    sh:nodeKind sh:IRI ;
    sh:message "dateEvidence must reference an IRI (expected a concept of szdg:DatumEvidenz)."@en .
